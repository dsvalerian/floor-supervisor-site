---
import type { CustomPost } from "../types/sanity.types";
import CustomPostView from "./posts/CustomPostView.astro";

type Props = {
	posts: CustomPost[];
};

const { posts } = Astro.props;
---

<section class="feed-section">
	{
		posts.map(post => {
			switch (post._type) {
				case "customPost":
					return <CustomPostView config={post} />;
			}
		})
	}
</section>

<script type="module" is:inline>
	import { initPostFiltering } from "/src/lib/filterPosts.ts";
	initPostFiltering();
</script>

<style>
	.feed-section {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 860px;
		margin: 0 auto;
	}
</style>
