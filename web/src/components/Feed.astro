---
import { getAllPosts } from "../lib/sanityQueries";
import PostCard from "./PostCard.astro";

const posts = await getAllPosts();
---

<section class="feed-section">
	{posts.map((post) => <PostCard config={post} />)}
</section>

<style>
	.feed-section {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 860px;
		margin: 0 auto;
	}
</style>
