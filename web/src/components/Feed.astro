---
import { getAllPosts } from "../lib/sanityQueries";
import EventPost from "./posts/EventPost.astro";
import MusicPost from "./posts/MusicPost.astro";
import PostCard from "./posts/PostCard.astro";

const posts = await getAllPosts();
---

<section class="feed-section">
	{
		posts.map((post) => {
			switch (post._type) {
				case "musicPost":
					return <MusicPost config={post} />;
				case "eventPost":
					return <EventPost config={post} />;
			}
		})
	}
</section>

<style>
	.feed-section {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 860px;
		margin: 0 auto;
	}
</style>
