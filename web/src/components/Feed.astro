---
import type { CustomPost } from "../types/sanity.types";
import CustomPostView from "./posts/CustomPostView.astro";

type Props = {
	posts: CustomPost[];
	allCategories: string[];
};

const { posts, allCategories } = Astro.props;
---

<section class="feed-section" data-feed-categories={JSON.stringify(allCategories)}>
	{
		posts
			.sort((a, b) => new Date(b._createdAt).getTime() - new Date(a._createdAt).getTime())
			.map(post => {
				switch (post._type) {
					case "customPost":
						return <CustomPostView config={post} />;
				}
			})
	}
</section>

<script>
	import { selectedCategories } from "../stores/categoriesStore";
	import { initPostFiltering } from "../lib/filterPosts";

	const allCategories = JSON.parse(
		(document.querySelector(".feed-section") as HTMLElement)?.dataset.feedCategories || "[]",
	);
	selectedCategories.set(allCategories);
	initPostFiltering();
</script>

<style>
	.feed-section {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 860px;
		margin: 0 auto;
	}
</style>
