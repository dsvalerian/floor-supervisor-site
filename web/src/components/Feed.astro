---
import { getAllPosts } from "../lib/sanityQueries";
import CustomPostView from "./posts/CustomPostView.astro";
import TextPostView from "./posts/TextPostView.astro";

const posts = await getAllPosts();
---

<section class="feed-section">
	{
		posts.map((post) => {
			switch (post._type) {
				case "customPost":
					return <CustomPostView config={post} />;
				case "textPost":
					return <TextPostView config={post} />;
			}
		})
	}
</section>

<style>
	.feed-section {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 860px;
		margin: 0 auto;
	}
</style>
