---
import ForwardButton from "./controls/ForwardButton.astro";
import PlayPauseButton from "./controls/PlayPauseButton.astro";
import RewindButton from "./controls/RewindButton.astro";

interface Props {
	songUrl?: string;
}

const { songUrl } = Astro.props;
---

<section class="music-player-container">
	<audio id="global-audio" src={songUrl}></audio>
	<div class="music-player">
		<div class="music-controls">
			<RewindButton />
			<PlayPauseButton id="main-play-pause-button" />
			<ForwardButton />
		</div>
	</div>
</section>

<script>
	const playPauseButton = document.getElementById("main-play-pause-button");
	const playIcon = playPauseButton?.children[0] as HTMLElement;
	const pauseIcon = playPauseButton?.children[1] as HTMLElement;

	console.log("play icon", playIcon);
	console.log("pause icon", pauseIcon);

	const toggleAudioPlay = () => {
		const audio = document.getElementById("global-audio") as HTMLAudioElement;
		if (audio.paused) {
			audio.play();
			playIcon.style.display = "none";
			pauseIcon.style.display = "";
		} else {
			audio.pause();
			playIcon.style.display = "";
			pauseIcon.style.display = "none";
		}
	};

	playPauseButton?.addEventListener("click", toggleAudioPlay);
</script>

<style>
	.music-player-container {
		background: var(--color-background-light);
	}

	.music-player {
		margin: 0 auto;
		max-width: 1024px;
		padding: 0.5rem;
	}

	.music-controls {
		display: flex;
		justify-content: space-around;
	}
</style>
