---
import type { MusicPost } from "../types/sanityTypes";
import PostMusicPlayer from "./player/PostMusicPlayer/PostMusicPlayer";
import { Image } from "astro:assets";

interface Props {
	config: MusicPost;
}

const { config } = Astro.props;
---

<div class="music-post">
	<div class="release-info">
		<div class="release-cover-art">
			{config.releaseCoverArt && <Image
				alt=`${config.releaseName} cover art`
				src={config.releaseCoverArt}
				inferSize
			/>}
		</div>
		<div class="release-info-text">
			<p class="release-name">{config.releaseName}</p>
			<p class="release-artist">{config.releaseArtist}</p>
			<p class="release-description">{config.releaseDescription}</p>
		</div>
	</div>
	<ul class="track-list">
		{
			config.trackInfos.map((trackInfo) => (
				<li>
					<PostMusicPlayer
						client:load
						track={{
							url: trackInfo.trackFile,
							name: trackInfo.trackName,
							artist: trackInfo.trackArtist,
						}}
					/>
				</li>
			))
		}
	</ul>
</div>

<style>
	.music-post {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.track-list {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		list-style-type: none;
	}

	.release-info {
		display: flex;
		align-items: start;
		gap: 1rem;
		margin-left: 1rem;
	}

	.release-cover-art {
		max-width: calc(min(300px, 33%));
		aspect-ratio: 1 / 1;
	}

	.release-cover-art img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.release-info-text {
		display: flex;
		flex-direction: column;
	}

	.release-name {
		font-size: var(--font-size-2xl);
		font-weight: var(--font-weight-semibold);
	}

	.release-artist {
		font-size: var(--font-size-normal);
		font-weight: var(--font-weight-semilight);
	}

	.release-description {
		white-space: pre-wrap;
		font-size: var(--font-size-2xs);
		font-weight: var(--font-weight-normal);
		margin-top: 1rem;
	}
</style>
