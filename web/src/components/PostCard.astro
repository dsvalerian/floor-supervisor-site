---
import type { Post } from "../types/sanity";
import SingleTrackPost from "./SingleTrackPost.astro";

interface Props {
	config: Post;
}

const { config: post } = Astro.props;
---

<article class="post-card">
	<h2>{post.postTitle}</h2>
	{post._type === "singleTrackPost" && <SingleTrackPost config={post} />}
	<!-- More post types here -->
</article>

<style define:vars={{ background: post.background }}>
	.post-card {
		padding: 1rem;
		box-shadow: var(--shadow-md);
		background: var(--background);
	}
</style>
