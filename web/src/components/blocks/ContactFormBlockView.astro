---
import type { ContactFormBlock, TextBlock } from "../../types/sanity.types";
import BlockWrapper from "./BlockWrapper.astro";

type Props = {
	config: ContactFormBlock;
	postTextColor: "light" | "dark";
};

const {
	config: { blockColors, title },
	postTextColor,
} = Astro.props;

if (!blockColors) {
	throw new Error("Missing block colors from contact form block.");
}

const resolvedTextColor = blockColors.textColor === "inherit" ? postTextColor : blockColors.textColor;
const textColorVar = `var(--color-text-${resolvedTextColor})`;
const oppositeColorVar = `var(--color-text-${resolvedTextColor === "dark" ? "light" : "dark"})`;
---

<BlockWrapper config={{ ...blockColors, postTextColor }}>
	<div class="form-container">
		{title && <p class="contact-title">{title}</p>}
		<form class="form" action="https://formsubmit.co/f0e81aa5ebd0c9c5ed38a1ea0639427d" method="POST">
			<input class="input" type="text" name="name" placeholder="Your name" required />
			<input class="input" type="email" name="email" placeholder="Your email" required />
			<textarea rows="5" class="input textarea" name="message" placeholder="Your message" required></textarea>
			<button class="button" type="submit">SEND</button>
		</form>
	</div>
</BlockWrapper>

<style define:vars={{ textColor: textColorVar, oppositeColor: oppositeColorVar }}>
	.form-container {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.contact-title {
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-semibold);
		align-self: center;
		text-align: center;
	}

	.form {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: center;
	}

	.input {
		width: 100%;
		max-width: 600px;
		border-radius: none;
		border: none;
		outline: 3px solid var(--textColor);
		color: var(--textColor);
		background: transparent;
		padding: 0.5rem;
		font-family: var(--font-family-text);
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-normal);
		transition-duration: var(--transition-normal);
		border-radius: var(--radius-normal);
	}

	.input:focus {
		outline-offset: 2px;
	}

	.input::placeholder {
		color: var(--textColor);
		opacity: 0.5;
	}

	.button {
		width: 100%;
		max-width: 600px;
		border-radius: none;
		border: none;
		border: none;
		outline: 3px solid var(--textColor);
		color: var(--oppositeColor);
		background: var(--textColor);
		padding: 0.5rem;
		font-family: var(--font-family-text);
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-normal);
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		border-radius: var(--radius-normal);
		font-weight: var(--font-weight-bold);
		font-size: var(--font-size-sm);
	}

	.button:hover {
		background: transparent;
		color: var(--textColor);
	}

	.textarea {
		resize: none;
		height: 6rem;
	}
</style>
