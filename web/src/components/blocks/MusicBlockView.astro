---
import type { MusicBlock } from "../../types/sanity.types";
import BlockWrapper from "./BlockWrapper.astro";
import PostMusicPlayer from "../player/PostMusicPlayer/PostMusicPlayer";
import { Image } from "astro:assets";

type Props = {
	config: MusicBlock;
	postTextColor: "light" | "dark";
};

const {
	config: { blockColors, name, artist, coverArt, musicTracks },
	postTextColor,
} = Astro.props;

if (!blockColors || !musicTracks) {
	throw new Error("Missing block colors or music tracks for music post.");
}
---

<BlockWrapper config={{...blockColors, postTextColor}}>
	<div class="music-block-content">
		{
			coverArt && (
				<div class="release-cover-art">
					<Image alt={`${name} cover art`} src={coverArt} inferSize />
				</div>
			)
		}
		<div class="release-tracks-container">
			<div class="release-info">
				{name && <p class="release-name">{name}</p>}
				{artist && <p class="release-artist">{artist}</p>}
			</div>
			{
				musicTracks && musicTracks.length > 0 && (
					<ul class="track-list">
						{musicTracks.map((track) => (
							<li>
								<PostMusicPlayer
									client:load
									track={{
										url: track.audioFile || "",
										name: track.name || "",
										artist: track.artist || "",
									}}
									textColor={blockColors?.textColor === "inherit" ? postTextColor : blockColors.textColor!}
								/>
							</li>
						))}
					</ul>
				)
			}
		</div>
	</div>
</BlockWrapper>

<style>
	.music-block-content {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.track-list {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		list-style-type: none;
	}

	.release-cover-art {
		max-width: 50%;
		aspect-ratio: 1 / 1;
		align-self: center;
	}

	.release-cover-art img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		box-shadow: var(--shadow-md);
	}

	.release-tracks-container {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		width: 100%;
	}

	.release-info {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.release-name {
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-semibold);
	}

	.release-artist {
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-light);
	}

	@media (min-width: 768px) {
		.music-block-content {
			flex-direction: row;
		}

		.release-cover-art {
			align-self: start;
			max-width: calc(min(300px, 33%);
		}
	}
</style>
