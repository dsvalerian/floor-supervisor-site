---
import { createImageUrlBuilder } from "@sanity/image-url";
import type { PhotoBlock } from "../../types/sanity.types";
import BlockWrapper from "./BlockWrapper.astro";
import Image from "astro/components/Image.astro";
import { sanityClient } from "sanity:client";

type Props = {
	config: PhotoBlock;
};

const {
	config: { blockDetails, photos },
} = Astro.props;

if (!blockDetails || !photos) {
	throw new Error("Must provide block details and photos for photo block.");
}

const builder = createImageUrlBuilder(sanityClient);
const photosWithUrls = photos.map(photo => ({
	...photo,
	url: builder.image(photo.image).url(),
	alt: photo.alt || "",
}));
---

<BlockWrapper config={{ ...blockDetails, padding: false }}>
	<div class="images">
		{
			photosWithUrls.map(photo => (
				<div class="image-wrapper">
					<Image src={photo.url} alt={photo.alt} layout="constrained" inferSize />
				</div>
			))
		}
	</div>
</BlockWrapper>

<style>
	.images {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.image-wrapper {
		width: 100%;
		padding: 0;
		margin: 0;
	}

	.image-wrapper img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
</style>
