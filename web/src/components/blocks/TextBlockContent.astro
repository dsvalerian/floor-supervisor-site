---
import type { TextBlock } from "../../types/sanity.types";
import BlockWrapper from "./BlockWrapper.astro";

type Props = {
	config: TextBlock;
};

const {
	config: { text = "", size = "small", alignment = "center", blockDetails },
} = Astro.props;

if (!blockDetails) {
	throw new Error("Must provide block details for text block.");
}

const align =
	(alignment === "left" && "start") ||
	(alignment === "right" && "end") ||
	"center";

const fontSize =
	(size === "small" && "var(--font-size-small)") ||
	(size === "medium" && "var(--font-size-xl)") ||
	"var(--font-size-4xl)";

const fontWeight =
	(size === "small" && "var(--font-weight-semilight") ||
	(size === "medium" && "var(--font-weight-normal)") ||
	"var(--font-weight-bold)";
---

<BlockWrapper config={blockDetails}>
	<div class="text-block-container">
		<p class="text-content">{text}</p>
	</div>
</BlockWrapper>

<style
	define:vars={{
		align: align,
		fontSize: fontSize,
		fontWeight: fontWeight,
	}}
>
	.text-block-container {
		display: flex;
		flex-direction: column;
		align-items: var(--align);
	}

	.text-content {
		width: fit-content;
		text-align: var(--align);
		font-size: var(--fontSize);
		font-weight: var(--fontWeight);
	}
</style>
