---
import type { TextBlock } from "../../types/sanity.types";
import BlockWrapper from "./BlockWrapper.astro";

type Props = {
	config: TextBlock;
};

const {
	config: { blockDetails, customTexts },
} = Astro.props;

if (!blockDetails || !customTexts) {
	throw new Error(
		"Must provide block details and custom text objects for text block.",
	);
}
---

<BlockWrapper config={blockDetails}>
	<div class="text-block-container">
		{
			customTexts.map((customText) => (
				<p
					class={`text-content ${customText.textAlignment?.toLowerCase()} ${customText.textSize?.toLowerCase()}`}
				>
					{customText.text}
				</p>
			))
		}
	</div>
</BlockWrapper>

<style>
	.text-block-container {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.left {
		align-self: start;
		text-align: left;
	}

	.right {
		align-self: end;
		text-align: right;
	}

	.center {
		align-self: center;
		text-align: center;
	}

	.small {
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-semilight);
	}

	.medium {
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-semibold);
	}

	.large {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-bold);
	}
</style>
