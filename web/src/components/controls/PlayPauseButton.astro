---
interface Props {
	id: string;
}

const { id } = Astro.props;
---

<button id={id}>
	<span id="icon-play" class="material-icons-outlined play-circle"
		>play_circle</span
	>
	<span
		id="icon-pause"
		class="material-icons-outlined pause-circle"
		style="display: none">pause_circle</span
	>
</button>

<style>
	button {
		background: none;
		border: none;
		cursor: pointer;
		transition-duration: 0.2s;
	}

	button:hover {
		color: var(--color-accent);
	}

	.play-circle {
		font-size: 48px;
		user-select: none;
	}

	.pause-circle {
		font-size: 48px;
		user-select: none;
	}
</style>
