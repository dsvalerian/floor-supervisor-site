---
import type { Post } from "../../types/sanityTypes";

interface Props {
	config: Post;
}

const { config } = Astro.props;

// Compute the CSS variable name based on textColor value
const textColorVar = `var(--color-text-${config.textColor})`;
---

<article class="post-card">
	<div
		class="post-label-container"
		style=`justify-content: ${config.postTitleAlignment === "right" && "end" || "start"}`
	>
		<h2 class="post-label">{config.postTitle?.toUpperCase()}</h2>
	</div>
	<div class="post-content">
		<slot />
	</div>
</article>

<style
	define:vars={{
		background: config.backgroundColor,
		textColor: textColorVar,
	}}
>
	.post-card {
		box-shadow: var(--shadow-md);
		background: var(--background);
		border-radius: var(--radius-normal);
		overflow: hidden;
	}

	.post-card > * {
		color: var(--textColor);
	}

	.post-content {
		padding: 2rem;
	}

	.post-label-container {
		display: flex;
	}

	.post-label {
		background: red;
		color: white;
		padding: 0.5rem 1rem;
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-bold);
		font-family: var(--font-family-header);
	}
</style>
