---
import type { Post } from "../../types/sanityTypes";

interface Props {
	config: Post;
}

const { config } = Astro.props;
---

<article class="post-card">
	<div
		class="post-label-container"
		style=`justify-content: ${config.postTitleAlignment === "right" && "end" || "start"}`
	>
		<h2 class="post-label">{config.postTitle}</h2>
	</div>
	<div class="post-content">
		<slot />
	</div>
</article>

<style define:vars={{ background: config.background }}>
	.post-card {
		box-shadow: var(--shadow-md);
		background: var(--background);
		border-radius: var(--radius-normal);
		overflow: hidden;
	}

	.post-content {
		padding: 1rem;
	}

	.post-label-container {
		display: flex;
	}

	.post-label {
		background: red;
		color: white;
		padding: 0.25rem 0.75rem;
		font-size: var(--font-size-normal);
		font-weight: var(--font-weight-semibold);
	}
</style>
