---
import type { PostDetails } from "../../types/sanity.types";

type Props = {
	config: PostDetails;
	// Optional: pass the post document id to enable sessionStorage persistence
	// of the expanded/collapsed state across UI re-renders on the same page.
	postId?: string;
};

const {
	config: { label, background },
	postId,
} = Astro.props;

if (!label || !background) {
	throw new Error("Must provide post details.");
}

// Compute the CSS variable name based on textColor value
const textColorVar = `var(--color-text-${label.textColor})`;
const alignVar = (label.alignment === "left" && "start") || (label.alignment === "right" && "end") || "center";
---

<article class="post-card" data-post-id={postId}>
	{
		label.text && (
			<div class="post-label-container">
				<h2 class="post-label">{label.text.toUpperCase()}</h2>
			</div>
		)
	}
	<div class="post-content">
		<div class="post-content-inner">
			<slot />
		</div>
	</div>
</article>

<style
	define:vars={{
		postBackground: background,
		labelBackground: label.background,
		textColor: textColorVar,
		alignment: alignVar,
	}}
>
	.post-card {
		box-shadow: var(--shadow-md);
		background: var(--postBackground);
		border-radius: var(--radius-normal);
		overflow: hidden;
		position: relative;
	}

	.post-card > * {
		color: var(--textColor);
	}

	.post-content {
		display: flex;
		flex-direction: column;
		position: relative;
		--postFadeTo: var(--color-background);
	}

	.post-content-inner {
		display: flex;
		flex-direction: column;
	}

	.post-label-container {
		display: flex;
		justify-content: var(--alignment);
		position: absolute;
		left: 0;
		right: 0;
		z-index: 3;
		pointer-events: none;
	}

	.post-label {
		background: var(--labelBackground);
		color: white;
		padding: 0.5rem 1rem;
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-bold);
		font-family: var(--font-family-header);
	}
</style>
