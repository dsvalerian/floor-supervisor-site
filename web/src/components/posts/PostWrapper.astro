---
import type { PostDetails } from "../../types/sanity.types";

type Props = {
	config: PostDetails;
	// Optional: pass the post document id to enable sessionStorage persistence
	// of the expanded/collapsed state across UI re-renders on the same page.
	postId?: string;
	isCollapsible?: boolean;
};

const {
	config: { label, background, category },
	postId,
	isCollapsible = false,
} = Astro.props;

if (!label || !background) {
	throw new Error("Must provide post details.");
}

// Compute the CSS variable name based on textColor value
const textColorVar = `var(--color-text-${label.textColor})`;
const alignVar = (label.alignment === "left" && "start") || (label.alignment === "right" && "end") || "center";
---

<article class="post-card" data-post-id={postId} data-post-category={category}>
	{
		label.text && (
			<div class="post-label-container">
				<h2 class="post-label">{label.text.toUpperCase()}</h2>
			</div>
		)
	}
	<div class="post-content" data-collapsed={isCollapsible ? "true" : undefined}>
		<div class="post-content-inner">
			<slot />
		</div>
		{
			isCollapsible && (
				<button class="expand-button" aria-label="Expand post">
					<span class="expand-text">Show More</span>
					<span class="expand-icon">▼</span>
				</button>
			)
		}
	</div>
</article>

<style
	define:vars={{
		postBackground: background,
		labelBackground: label.background,
		textColor: textColorVar,
		alignment: alignVar,
	}}
>
	.post-card {
		box-shadow: var(--shadow-md);
		background: var(--postBackground);
		border-radius: var(--radius-normal);
		overflow: hidden;
		position: relative;
	}

	.post-card > * {
		color: var(--textColor);
	}

	.post-content {
		display: flex;
		flex-direction: column;
		position: relative;
		--postFadeTo: var(--color-background);
	}

	.post-content-inner {
		display: flex;
		flex-direction: column;
	}

	.post-label-container {
		display: flex;
		justify-content: var(--alignment);
		position: absolute;
		left: 0;
		right: 0;
		z-index: 3;
		pointer-events: none;
	}

	.post-label {
		background: var(--labelBackground);
		color: white;
		padding: 0.5rem 1rem;
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-bold);
		font-family: var(--font-family-header);
	}

	.post-content[data-collapsed="true"] :global(.block:not(:first-child)) {
		display: none;
	}

	.expand-button {
		position: relative;
		z-index: 2;
		width: 100%;
		padding: 1rem;
		background: var(--labelBackground);
		border: none;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		padding: 0.75rem;
		color: var(--textColor);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-semibold);
		font-family: var(--font-family-text);
		transition: opacity var(--transition-normal);
		text-transform: uppercase;
		user-select: none;
	}

	.expand-button:hover {
		opacity: 0.9;
	}

	.expand-icon {
		transition: transform 0.3s ease;
	}

	.post-content[data-collapsed="false"] .expand-icon {
		transform: rotate(180deg);
	}
</style>

<script>
	document.querySelectorAll(".post-card").forEach(post => {
		const postId = post.getAttribute("data-post-id");
		const content = post.querySelector(".post-content");
		const button = post.querySelector(".expand-button");
		const textSpan = button?.querySelector(".expand-text");

		if (!content || !button || !textSpan) return;

		const storageKey = postId ? `post-expanded-${postId}` : null;
		const savedState = storageKey ? sessionStorage.getItem(storageKey) : null;
		const isExpanded = savedState === "true";

		if (isExpanded) {
			content.setAttribute("data-collapsed", "false");
			textSpan.textContent = "Show Less";
		}

		button.addEventListener("click", () => {
			const currentlyCollapsed = content.getAttribute("data-collapsed") === "true";

			if (currentlyCollapsed) {
				content.setAttribute("data-collapsed", "false");
				textSpan.textContent = "Show Less";
				if (storageKey) sessionStorage.setItem(storageKey, "true");
			} else {
				content.setAttribute("data-collapsed", "true");
				textSpan.textContent = "Show More";
				if (storageKey) sessionStorage.setItem(storageKey, "false");
			}
		});
	});
</script>
