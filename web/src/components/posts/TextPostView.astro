---
import type { TextPost } from "../../types/sanity.types";
import TextBlockView from "../blocks/TextBlockView.astro";
import PostWrapper from "./PostWrapper.astro";

type Props = {
	config: TextPost;
};

const {
	config: { postDetails, content },
} = Astro.props;

if (!postDetails || !content) {
	throw new Error("Must provide post details and content for a text post.");
}
---

<PostWrapper config={postDetails}>
	<TextBlockView config={content} />
</PostWrapper>
