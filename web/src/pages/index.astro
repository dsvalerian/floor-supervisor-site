---
import Feed from "../components/Feed.astro";
import FilterButton from "../components/player/FilterButton/FilterButton";
import FilterMenuContainer from "../components/player/FilterMenu/FilterMenuContainer";
import MusicPlayer from "../components/player/MusicPlayer/MusicPlayer";
import { getAllPosts } from "../lib/sanityQueries";
import "../styles/global.css";

const posts = await getAllPosts();
const categories = Array.from(new Set(posts.map(post => post.category).filter((c): c is string => !!c)));
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet" />
		<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Floor Supervisor</title>
		<meta name="description" content="Professional portfolio website for Chicago DJ Floor Supervisor." />
	</head>
	<body>
		<header><div class="menu"><FilterButton client:load /></div></header>
		<main>
			<Feed posts={posts} allCategories={categories} />
		</main>
		<FilterMenuContainer client:load categories={categories} />
		<footer>
			<MusicPlayer client:load categories={categories} />
		</footer>
	</body>
</html>

<style>
	body {
		height: 100vh;
	}

	header {
		display: flex;
		justify-content: flex-end;
		position: fixed;
		top: 0;
		right: 0;
		z-index: 10000;
	}

	.menu {
		position: fixed;
		width: fit-content;
		height: fit-content;
		margin-top: 1.25rem;
		margin-right: 1.25rem;
		z-index: 10001;
		padding: 4px;
		background: hsla(var(--color-background-hsl) / 0.8);
		backdrop-filter: blur(4px);
		border: 1px solid var(--color-controls-light-extra-muted);
	}

	main {
		padding: 1rem;
		position: relative;
		z-index: 0;
		padding-bottom: 6.5rem;
	}

	footer {
		position: sticky;
		bottom: 0;
		width: 100%;
	}
</style>
