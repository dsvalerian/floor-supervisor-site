---
import Feed from "../components/Feed.astro";
import FilterButton from "../components/player/FilterButton/FilterButton";
import FilterMenuContainer from "../components/player/FilterMenu/FilterMenuContainer";
import MusicPlayer from "../components/player/MusicPlayer/MusicPlayer";
import { getAllPosts } from "../lib/sanityQueries";
import "../styles/global.css";

const posts = await getAllPosts();
const categories = Array.from(new Set(posts.map(post => post.category).filter((c): c is string => !!c)));
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet" />
		<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Floor Supervisor</title>
		<meta name="description" content="Professional portfolio website for Chicago DJ Floor Supervisor." />
	</head>
	<body>
		<header>
			<div class="header-content">
				<p class="header-title">FLOOR SUPERVISOR</p>
				<FilterButton client:load />
			</div>
		</header>
		<main>
			<Feed posts={posts} allCategories={categories} />
		</main>
		<FilterMenuContainer client:load categories={categories} />
		<footer>
			<MusicPlayer client:load categories={categories} />
		</footer>
	</body>
</html>

<style>
	body {
		height: auto;
	}

	header {
		position: sticky;
		top: 0;
		z-index: 1000;
		background: hsla(var(--color-background-hsl) / 0.8);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--color-controls-light-extra-muted);
		width: 100%;
	}

	.header-content {
		display: flex;
		justify-content: space-between;
		align-items: center;
		max-width: 860px;
		padding: 0.5rem 1rem;
		margin: 0 auto;
	}

	.header-title {
		color: var(--color-text-light);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-bold);
		font-family: var(--font-family-text);
	}

	main {
		position: relative;
		z-index: 0;
		padding: 1rem 1rem 6.5rem 1rem;
		max-width: 860px;
		margin: 0 auto;
	}

	footer {
		position: sticky;
		bottom: 0;
		width: 100%;
	}
</style>
